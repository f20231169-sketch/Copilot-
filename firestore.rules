rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.uid == userId &&
             data.displayName is string && data.displayName.size() <= 256 &&
             data.email is string && data.email.size() <= 256 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 64)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidConversation(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'model', 'role', 'messageCount', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'model', 'role', 'messageCount', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 256 &&
             data.model is string && data.model.size() <= 64 &&
             data.role is string && data.role.size() <= 64 &&
             data.messageCount is number && data.messageCount >= 0 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, conversationId) {
      return data.keys().hasAll(['id', 'userId', 'conversationId', 'sender', 'content', 'timestamp', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'conversationId', 'sender', 'content', 'modelUsed', 'roleUsed', 'timestamp', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.conversationId == conversationId &&
             data.id is string && isValidId(data.id) &&
             data.sender in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 100000 &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 64)) &&
             (!('roleUsed' in data) || (data.roleUsed is string && data.roleUsed.size() <= 64)) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.createdAt is timestamp;
    }

    function isValidSavedAudit(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'datasetName', 'voicesCount', 'csatAverage', 'topCluster', 'topStore', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'datasetName', 'voicesCount', 'csatAverage', 'topCluster', 'topStore', 'notes', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() <= 256 &&
             data.datasetName is string && data.datasetName.size() <= 256 &&
             data.voicesCount is number && data.voicesCount >= 0 &&
             data.csatAverage is number &&
             data.topCluster is string && data.topCluster.size() <= 256 &&
             data.topStore is string && data.topStore.size() <= 128 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000)) &&
             data.createdAt is timestamp;
    }

    // Match /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket listing of all users is strictly blocked

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Conversations
      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(conversationId) &&
                         incoming().id == conversationId &&
                         isValidConversation(incoming(), userId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'model', 'role', 'messageCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);

        // Subcollection: Messages
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           incoming().id == messageId &&
                           isValidChatMessage(incoming(), userId, conversationId) &&
                           incoming().createdAt == request.time;

          allow update: if false; // Messages in conversation thread are immutable
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      // Subcollection: Saved Audits
      match /savedAudits/{auditId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(auditId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(auditId) &&
                         incoming().id == auditId &&
                         isValidSavedAudit(incoming(), userId) &&
                         incoming().createdAt == request.time;

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(auditId) &&
                         isValidSavedAudit(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(auditId);
      }
    }
  }
}
