{
  "entities": {
    "UserProfile": {
      "path": "/users/{userId}",
      "description": "User profile record created on Google Sign-In with Firebase Auth",
      "fields": {
        "uid": { "type": "string", "description": "Auth UID, must match userId", "maxSize": 128 },
        "displayName": { "type": "string", "description": "User display name", "maxSize": 256 },
        "email": { "type": "string", "description": "User email address", "maxSize": 256 },
        "photoURL": { "type": "string", "description": "Avatar URL", "maxSize": 1024 },
        "role": { "type": "string", "description": "Operational role (operations_lead, product_manager, executive_vp)", "maxSize": 64 },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Last profile update timestamp" }
      }
    },
    "Conversation": {
      "path": "/users/{userId}/conversations/{conversationId}",
      "description": "Multi-turn Gemini chat conversation thread",
      "fields": {
        "id": { "type": "string", "description": "Conversation ID", "maxSize": 128 },
        "userId": { "type": "string", "description": "Owner UID", "maxSize": 128 },
        "title": { "type": "string", "description": "Conversation topic title", "maxSize": 256 },
        "model": { "type": "string", "description": "Gemini model identifier", "maxSize": 64 },
        "role": { "type": "string", "description": "System persona role", "maxSize": 64 },
        "messageCount": { "type": "number", "description": "Total messages in thread" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Update timestamp" }
      }
    },
    "ChatMessage": {
      "path": "/users/{userId}/conversations/{conversationId}/messages/{messageId}",
      "description": "Individual message in a multi-turn chat session",
      "fields": {
        "id": { "type": "string", "description": "Message ID", "maxSize": 128 },
        "userId": { "type": "string", "description": "Author UID", "maxSize": 128 },
        "conversationId": { "type": "string", "description": "Parent conversation ID", "maxSize": 128 },
        "sender": { "type": "string", "description": "user or assistant", "maxSize": 32 },
        "content": { "type": "string", "description": "Message text body", "maxSize": 100000 },
        "modelUsed": { "type": "string", "description": "Model used for generation", "maxSize": 64 },
        "roleUsed": { "type": "string", "description": "System instruction role used", "maxSize": 64 },
        "timestamp": { "type": "string", "description": "Human-readable time string", "maxSize": 64 },
        "createdAt": { "type": "timestamp", "description": "Server creation timestamp" }
      }
    },
    "SavedAudit": {
      "path": "/users/{userId}/savedAudits/{auditId}",
      "description": "Persisted customer feedback triage and audit snapshot",
      "fields": {
        "id": { "type": "string", "description": "Audit ID", "maxSize": 128 },
        "userId": { "type": "string", "description": "Owner UID", "maxSize": 128 },
        "title": { "type": "string", "description": "Audit title", "maxSize": 256 },
        "datasetName": { "type": "string", "description": "Source dataset name", "maxSize": 256 },
        "voicesCount": { "type": "number", "description": "Total customer voices analyzed" },
        "csatAverage": { "type": "number", "description": "Computed CSAT average" },
        "topCluster": { "type": "string", "description": "Highest risk cluster title", "maxSize": 256 },
        "topStore": { "type": "string", "description": "Most impacted facility", "maxSize": 128 },
        "notes": { "type": "string", "description": "Operator notes", "maxSize": 10000 },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" }
      }
    }
  }
}
